# nginx in front of tm-server. The app itself has no login on purpose; this is the lock.
# Run the app bound to loopback first:  SERVER_ADDRESS=127.0.0.1  (see docs/EXPOSING_THE_SERVER.md)
#
# Make the password file with:   printf 'me:%s\n' "$(openssl passwd -apr1)" | sudo tee /etc/nginx/tm.htpasswd
# HTTPS certificates: certbot --nginx -d invest.example.com

server {
    listen 443 ssl;
    server_name invest.example.com;
    # ssl_certificate / ssl_certificate_key lines are added by certbot.

    # Only these networks may reach the app (delete the allow/deny lines to rely on the password alone).
    allow 203.0.113.0/24;
    allow 198.51.100.7;
    deny  all;

    auth_basic           "tm";
    auth_basic_user_file /etc/nginx/tm.htpasswd;

    # The app caps bodies at 2 MiB; match it so oversized requests die at the edge.
    client_max_body_size 2m;

    location / {
        proxy_pass         http://127.0.0.1:8080;
        proxy_set_header   Host $host;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        # AI calls can take a while.
        proxy_read_timeout 120s;
    }
}

server {
    listen 80;
    server_name invest.example.com;
    return 301 https://$host$request_uri;
}
