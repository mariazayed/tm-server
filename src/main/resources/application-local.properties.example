# Copy this file to application-local.properties (already in .gitignore) and fill
# in your real local database credentials. Activate it with the "local" Spring
# profile -- see the comment at the top of application-local.properties, or the
# README, for how.
spring.datasource.username=postgres
spring.datasource.password=your_password_here

# Anthropic (paid): set ai.provider.type=anthropic and fill in the key and model below.
# AI suggestions (Phase 5) -- uncomment and fill in to enable POST
# /api/v1/trade/{id}/suggest. Get an API key from console.anthropic.com;
# set the model to whatever current Claude model your key has access to
# (see docs.claude.com/en/docs/about-claude/models for the current list --
# intentionally not hardcoded here since model ids change over time).
# ai.provider.api-key=sk-ant-...
# ai.provider.model=
# Master switch for the investing AI features; see application.properties for the limits.
# ai.enabled=true

# The default is a local Ollama (see application.properties). To use something else, pick ONE block.
# Other free OpenAI-compatible servers use ai.provider.type=openai; Anthropic uses ai.provider.type=anthropic.
# ai.provider.type=openai
#
# Google Gemini free tier (key from aistudio.google.com):
# ai.provider.base-url=https://generativelanguage.googleapis.com/v1beta/openai
# ai.provider.api-key=<gemini key>
# ai.provider.model=gemini-2.5-flash
# ai.provider.fallback-models=gemini-2.5-flash-lite
#
# Groq free tier (key from console.groq.com):
# ai.provider.base-url=https://api.groq.com/openai/v1
# ai.provider.model=llama-3.3-70b-versatile
#
# OpenRouter, models whose id ends in ":free" (key from openrouter.ai):
# ai.provider.base-url=https://openrouter.ai/api/v1
# ai.provider.model=<an id ending in :free>
#
# Ollama on this machine is already the default; change the model only if you pulled another:
# ai.provider.model=llama3.1:8b
#
# With a free tier the limit is the provider's (a few requests a minute, some hundreds a day),
# so keep ai.limits.per-minute and ai.limits.daily-total at or below what it allows.

# The server has no login. Uncomment to accept connections from this machine only
# (see docs/EXPOSING_THE_SERVER.md before exposing it anywhere else).
#server.address=127.0.0.1
